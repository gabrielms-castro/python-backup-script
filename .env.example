ENVIRONMENT="dev" # dev | prod

SOURCE_PATH=""                      # local dir where the dump is generated (required)
DEST_PATH=""                        # backup server dir (only for the ssh target)
LOGS_DIR=""

BACKUP_DAYS="7"

# SSH (backup server)
SSH_USER=""
SSH_PASSWORD=""
SSH_SERVER=""
SSH_PORT="22"
PUB_KEY_PATH=""

# Backup
DB_ENGINE="postgres"                # postgres | firebird | mysql | mariadb
COMPRESS_BACKUP="true"              # compress to .gz (true | false)
BACKUP_TARGETS="ssh"                # ssh | s3 | ssh,s3

# PostgreSQL (DB_ENGINE=postgres)
PG_HOST="localhost"
PG_PORT="5432"
PG_DB_NAME="backup_db"
PG_USER="backup_user"
PG_PASSWORD="backup_pass"

# Firebird (DB_ENGINE=firebird)
FB_HOST="localhost"
FB_PORT="3050"
FB_DATABASE="/var/lib/firebird/data/database.fdb"
FB_USER="SYSDBA"
FB_PASSWORD=""
FB_GBAK_PATH="gbak"                 # full path (/opt/firebird/bin/gbak) or 'gbak' if in PATH (e.g. symlink in /usr/bin)

# MySQL / MariaDB (DB_ENGINE=mysql | mariadb)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DATABASE=""
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DUMP_PATH=""                  # empty = mysqldump (mysql) / mariadb-dump (mariadb) from PATH

# Monitoring (optional)
HEALTHCHECK_URL=""                  # https://hc-ping.com/<uuid>; empty = disabled

# AWS S3 (BACKUP_TARGETS contains s3)
S3_BUCKET=""
S3_PREFIX="backups/firebird"
S3_STORAGE_CLASS="STANDARD" # STANDARD_IA only pays off with retention >= 30 days
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
